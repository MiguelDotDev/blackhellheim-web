{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.ts", "eslint.config.js", "tests/**/*", "src/**/*.test.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}
